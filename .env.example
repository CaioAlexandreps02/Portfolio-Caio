# Supabase — preencher quando o projeto for criado
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — só usada server-side (rota /go/[code]). Nunca expor com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada no sitemap, robots.txt e Open Graph)
NEXT_PUBLIC_SITE_URL=https://caio-portfolio.vercel.app

# Google Drive Picker (seletor nativo de imagens no admin) — Google Cloud Console
# Client ID e API key são públicas mesmo (usadas no navegador), não são segredo
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Client secret — SÓ server-side (troca/renovação de tokens OAuth). Nunca NEXT_PUBLIC_
GOOGLE_CLIENT_SECRET=
