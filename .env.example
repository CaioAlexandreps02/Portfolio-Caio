# Supabase — preencher quando o projeto for criado
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — só usada server-side (rota /go/[code]). Nunca expor com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada no sitemap, robots.txt e Open Graph)
NEXT_PUBLIC_SITE_URL=https://caio-portfolio.vercel.app
